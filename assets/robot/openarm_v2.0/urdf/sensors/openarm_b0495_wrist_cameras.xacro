<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Native OpenArm 2.0 in-gripper Arducam B0495 cameras (AR0234 sensor).

    The extrinsics were derived from the OpenArm 2.0 STEP assembly. The
    B0495 lens axis is the camera part's +Z axis and is coaxial with the
    16 mm opening in the gripper cover. The frame origin is placed at the
    outer face of that opening.

    The camera link uses the conventional body convention (+X forward,
    +Y left, +Z up). The optical child follows REP 103 (+X right, +Y down,
    +Z forward), with optical +Z aligned to the physical lens axis.
  -->
  <xacro:macro name="openarm_b0495_wrist_camera" params="side prefix">
    <xacro:property name="camera_name" value="${prefix}wrist_camera"/>
    <xacro:property name="camera_link" value="${camera_name}_link"/>
    <xacro:property name="optical_frame" value="${camera_name}_optical_frame"/>

    <xacro:if value="${side == 'left'}">
      <xacro:property name="mount_xyz" value="0.016886335745 0.016454180559 -0.106907202407" scope="parent"/>
      <xacro:property name="mount_rpy" value="1.040721499987 1.142447462628 -2.143098311417" scope="parent"/>
    </xacro:if>
    <xacro:if value="${side == 'right'}">
      <xacro:property name="mount_xyz" value="0.016886335745 -0.016454180559 -0.106907202407" scope="parent"/>
      <xacro:property name="mount_rpy" value="-1.040721499987 1.142447462628 2.143098311417" scope="parent"/>
    </xacro:if>

    <link name="${camera_link}"/>
    <joint name="${camera_name}_mount_joint" type="fixed">
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
      <parent link="${prefix}ee_base_link"/>
      <child link="${camera_link}"/>
    </joint>

    <link name="${optical_frame}"/>
    <joint name="${camera_name}_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <parent link="${camera_link}"/>
      <child link="${optical_frame}"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="openarm_b0495_wrist_cameras" params="">
    <xacro:openarm_b0495_wrist_camera side="left" prefix="openarm_left_"/>
    <xacro:openarm_b0495_wrist_camera side="right" prefix="openarm_right_"/>
  </xacro:macro>
</robot>
